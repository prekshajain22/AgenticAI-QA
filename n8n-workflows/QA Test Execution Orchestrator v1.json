        "jsCode": "const failedTests = $json.tests\n  ?.filter(test => test.status === \"FAILED\")\n  .map(test => ({\n    name: test.name,\n    reason: test.failure || \"Unknown failure\"\n  })) || [];\n\nreturn [\n  {\n    json: {\n      ...$json,\n      failure_summary: {\n        total_failures: failedTests.length,\n        failed_tests: failedTests\n      }\n    }\n  }\n];"
