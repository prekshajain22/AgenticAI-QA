        "html": "=<h2>Jira Bug Verification Pipeline Report</h2>\n<p><b>Status:</b> {{ $('Format Pipeline Results').item.json.status.toUpperCase() }}</p>\n<p><b>Job ID:</b> {{ $('Format Pipeline Results').item.json.job_id }}</p>\n<p><b>Started:</b> {{ $('Format Pipeline Results').item.json.started_at }}</p>\n<p><b>Finished:</b> {{ $('Format Pipeline Results').item.json.finished_at }}</p>\n<p><b>Elapsed:</b> {{ $('Format Pipeline Results').item.json.elapsed_minutes }} minutes</p>\n<hr>\n<h3>Stage 1 — Jira Bug Analysis</h3>\n<pre>{{ $('Format Pipeline Results').item.json.bug_analysis }}</pre>\n<hr>\n<h3>Stage 2 — Playwright Browser Execution</h3>\n<pre>{{ $('Format Pipeline Results').item.json.test_execution }}</pre>\n<hr>\n<h3>Stage 3 — Jira Comments Posted</h3>\n<pre>{{ $('Format Pipeline Results').item.json.jira_update }}</pre>\n<p>Full report attached as PDF.</p>",
        "options": {
