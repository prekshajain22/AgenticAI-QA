      "name": "Poll Pipeline Status"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Timeout guard — stop polling after MAX_MINUTES to prevent infinite loops.\nconst MAX_MINUTES = 15;\n\nconst status = $json.status || 'unknown';\nconst startedAt = $json.started_at ? new Date($json.started_at) : new Date();\nconst elapsedMs = Date.now() - startedAt.getTime();\nconst elapsedMinutes = elapsedMs / 60000;\nconst timedOut = elapsedMinutes >= MAX_MINUTES;\n\nreturn {\n  json: {\n    ...$json,\n    elapsed_minutes: parseFloat(elapsedMinutes.toFixed(1)),\n    timed_out: timedOut,\n    is_error_or_timeout: status === 'error' || timedOut\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1344, -1408],
      "id": "aa000005-0000-0000-0000-000000000005",
      "name": "Check Status & Timeout"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cc000001-0000-0000-0000-000000000001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "complete",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-1152, -1408],
      "id": "aa000006-0000-0000-0000-000000000006",
      "name": "Pipeline Complete?"
