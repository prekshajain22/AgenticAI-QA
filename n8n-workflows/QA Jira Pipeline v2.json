      "typeVersion": 1.1,
      "position": [-1152, -1520],
      "id": "aa000008-0000-0000-0000-000000000008",
      "name": "Still Running — Wait 30 s"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nreturn {\n  json: {\n    status: d.status,\n    job_id: d.job_id,\n    started_at: d.started_at,\n    finished_at: d.finished_at,\n    elapsed_minutes: d.elapsed_minutes,\n    bug_analysis: d.bug_analysis || 'No bug analysis available.',\n    test_execution: d.test_execution || 'No test execution report available.',\n    jira_update: d.jira_update || 'No Jira comments posted.'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
