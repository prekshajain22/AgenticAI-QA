      "id": "670abc6e-207d-45d8-8c92-9d9dbb8fd64f",
      "name": "Download QA Report"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "04dad9f6-8aa9-46a7-ad4c-d5fbf55748f8",
              "leftValue": "={{ $json.execution_status }}",
              "rightValue": "=PASSED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        320,
        -288
      ],
      "id": "974f9c3e-5e06-4eb7-b38a-87e8c867a5ee",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst failedTests = data.failed_tests || [];\n\nif (failedTests.length === 0) {\n  return [{\n      json: {\n        message: \"No failed tests found\"\n      }\n    }\n  ];\n}\n\nconst failure = failedTests[0];\n\nreturn [\n  {\n    json: {\n      issueType: \"Bug\",\n\n      project: \"QA-AUTOMATION\",\n\n      summary: `Automation Failure - ${failure.name}`,\n\n      description: `\nQA Automation Failure\n\nTest Name:\n${failure.name}\n\nFailed Step:\n${failure.failing_step}\n\nReason:\n${failure.reason || failure.crash_message || \"Unknown failure\"}\n\nScreenshot:\n${failure.screenshot  || \"Not available\"}\n\nExecution Summary:\n\nTotal Tests:\n${data.summary.total}\n\nPassed:\n${data.summary.passed}\n\nFailed:\n${data.summary.failed}\n\nDuration:\n${data.summary.duration} seconds\n`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -176
      ],
      "id": "482b2536-1f63-4d6c-a4a9-c4f452071fb9",
      "name": "Prepare Jira Payload"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "2e1b0986-a6bb-48cf-8105-6e9c41e78f05",
              "name": "jira_status",
              "value": "CREATED",
              "type": "string"
            },
            {
              "id": "eedfc18e-4051-49bf-9754-4b0c7ace1428",
              "name": "message",
              "value": "Mock Jira bug created successfully",
              "type": "string"
