    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\n\nreturn {\n  json: {\n    execution_time: new Date().toLocaleString(),\n\n    execution_status: data.execution_status,\n\n    total_tests: data.summary.total,\n\n    passed_tests: data.summary.passed,\n\n    failed_tests: data.summary.failed,\n\n    pass_percentage:\n      ((data.summary.passed / data.summary.total) * 100).toFixed(2),\n\n    duration: data.summary.duration,\n\n    jira_required: data.summary.failed > 0,\n\n    pdf_report: data.pdf_report,\n\n    html_report: data.html_report\n  }\n};"
      },
