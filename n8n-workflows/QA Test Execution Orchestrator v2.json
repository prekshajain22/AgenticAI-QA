    {
      "parameters": {
        "fromEmail": "={{ $env.QA_FROM_EMAIL }}",
        "toEmail": "={{ $env.QA_TO_EMAIL }}",
        "subject": "=QA Automation Execution - {{$node[\"Run Tests\"].json.execution_status || \"Unknown\"}}",
        "html": "=QA Automation Execution Completed\n\n<br><br>\n\n<b>Status:</b><br>\n{{$node[\"Run Tests\"].json.execution_status}}\n\n<br><br>\n\n<b>Summary</b><br>\n\nTotal Tests:\n{{$node[\"Run Tests\"].json.summary.total}}<br>\n\nPassed:\n{{$node[\"Run Tests\"].json.summary.passed}}<br>\n\nFailed:\n{{$node[\"Run Tests\"].json.summary.failed}}<br>\n\nDuration:\n{{$node[\"Run Tests\"].json.summary.duration}} seconds\n\n<br><br>\n\n<b>Failed Tests</b><br>\n\n{{\n$node[\"Run Tests\"].json.failed_tests.length\n? $node[\"Run Tests\"].json.failed_tests.map(test => `\n<hr>\n<b>Test:</b> ${test.name}<br>\n<b>Failing Step:</b> ${test.failing_step}<br>\n<b>Error:</b> ${test.reason || test.crash_message}<br>\n<b>Screenshot:</b> ${test.screenshot}<br>\n`).join(\"\")\n: \"None 🎉\"\n}}\n\n<br><br>\n\nReport attached.",
        "options": {
          "fileAttachments": "data"
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1440,
        -416
      ],
      "id": "e336efda-c1f0-45a8-bd6b-3f896c6da305",
      "name": "Send an Email",
      "webhookId": "6598fcc2-c02b-43c5-b2e8-d358a8eb3a26",
      "credentials": {
        "smtp": {
          "id": "AApLdx6JqlR3R3gN",
          "name": "SMTP account"
        }
      }
