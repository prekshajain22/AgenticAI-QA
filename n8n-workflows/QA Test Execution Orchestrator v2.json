      "name": "Mock Jira - Create Bug"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const bugSummary = $json.summary;\n\n// Mock list of existing Jira bugs\nconst existingBugs = [\n  \"Automation Failure - Login With Invalid Credentials Should Fail And Capture Screenshot\"\n];\n\nconst exists = existingBugs.includes(bugSummary);\n\nreturn {\n  json: {\n    ...$json,\n    bug_exists: exists\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
