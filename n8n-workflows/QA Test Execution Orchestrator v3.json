      "id": "959f2358-ed6b-490a-87e9-5330dd8332d4",
      "name": "Run Tests"
    },
    {
      "parameters": {
        "jsCode": "const jobId=$input.first().json.job_id;\nconst base='http://host.containers.internal:5000';\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\nlet elapsed=0,result;\nwhile(elapsed<600000){\n  const res=await fetch(`${base}/jobs/${jobId}`);\n  result=await res.json();\n  if(result.status==='completed'||result.status==='failed') break;\n  await sleep(5000);\n  elapsed+=5000;\n}\nif(!result||(result.status!=='completed'&&result.status!=='failed'))\n  throw new Error(`Timed out waiting for job ${jobId}`);\nif(result.status==='failed')\n  throw new Error(`Job ${jobId} failed: ${result.error}`);\nresult.job_id=jobId;\nreturn [{json:result}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-60, -288],
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Poll Until Complete"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d=$json;\nreturn {json:{execution_time:new Date().toLocaleString(),execution_status:d.execution_status,total_tests:d.summary.total,passed_tests:d.summary.passed,failed_tests:d.summary.failed,pass_percentage:((d.summary.passed/d.summary.total)*100).toFixed(2),duration:d.summary.duration,jira_required:d.summary.failed>0,pdf_report:d.pdf_report,html_report:d.html_report}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, -464],
