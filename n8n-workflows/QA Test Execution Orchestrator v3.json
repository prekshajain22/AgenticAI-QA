      "typeVersion": 4.4,
      "position": [-240, -288],
      "id": "959f2358-ed6b-490a-87e9-5330dd8332d4",
      "name": "Run Tests"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nconst passRate = d.summary.total > 0\n  ? ((d.summary.passed / d.summary.total) * 100).toFixed(1)\n  : '0.0';\nconst aiSummaries = (d.failed_tests || []).map(t =>\n  `Test: ${t.name}\\nError: ${t.reason}\\n\\nAI Analysis:\\n${t.ai_analysis || 'N/A'}`\n).join('\\n\\n---\\n\\n');\nreturn {\n  json: {\n    execution_status: d.execution_status,\n    email_message:    d.email_message,\n    pass_rate:        passRate,\n    total:            d.summary.total,\n    passed:           d.summary.passed,\n    failed:           d.summary.failed,\n    duration:         d.summary.duration,\n    ai_summary:       aiSummaries || 'All tests passed.',\n    failed_tests:     d.failed_tests,\n    summary:          d.summary,\n    pdf_report:       d.pdf_report,\n    run_id:           d.run_id\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-60, -288],
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567891",
      "name": "Format AI Summary"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "04dad9f6-8aa9-46a7-ad4c-d5fbf55748f8",
              "leftValue": "={{ $json.execution_status }}",
              "rightValue": "=PASSED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [160, -288],
      "id": "974f9c3e-5e06-4eb7-b38a-87e8c867a5ee",
      "name": "Execution Passed?"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst failedTests = data.failed_tests || [];\nif (failedTests.length === 0) return [{ json: { message: 'No failed tests found' } }];\nconst f = failedTests[0];\nreturn [{\n  json: {\n    issueType: 'Bug',\n    project: 'QA-AUTOMATION',\n    summary: `Automation Failure - ${f.name}`,\n    description: `QA Automation Failure\\n\\nTest: ${f.name}\\nStep: ${f.failing_step}\\nReason: ${f.reason || f.crash_message || 'Unknown'}\\nAI Analysis: ${f.ai_analysis || 'N/A'}\\nScreenshot: ${f.screenshot || 'N/A'}\\n\\nTotal: ${data.summary.total} Passed: ${data.summary.passed} Failed: ${data.summary.failed} Duration: ${data.summary.duration}s`,\n    failed_tests: data.failed_tests,\n    summary: data.summary,\n    execution_status: data.execution_status,\n    ai_summary: data.ai_summary,\n    email_message: data.email_message,\n    pass_rate: data.pass_rate,\n    duration: data.duration\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, -176],
      "id": "482b2536-1f63-4d6c-a4a9-c4f452071fb9",
      "name": "Prepare Jira Payload"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const existingBugs = [\n  'Automation Failure - Login With Invalid Credentials Should Fail And Capture Screenshot'\n];\nreturn { json: { ...$json, bug_exists: existingBugs.includes($json.summary) } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, -176],
