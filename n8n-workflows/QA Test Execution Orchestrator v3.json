    {
      "parameters": {
        "jsCode": "const data=$input.first().json;\nconst failedTests=data.failed_tests||[];\nif(failedTests.length===0) return [{json:{message:'No failed tests found'}}];\nconst f=failedTests[0];\nreturn [{json:{issueType:'Bug',project:'QA-AUTOMATION',summary:`Automation Failure - ${f.name}`,description:`QA Automation Failure\\n\\nTest: ${f.name}\\nStep: ${f.failing_step}\\nReason: ${f.reason||f.crash_message||'Unknown'}\\nScreenshot: ${f.screenshot||'N/A'}\\n\\nTotal: ${data.summary.total} Passed: ${data.summary.passed} Failed: ${data.summary.failed} Duration: ${data.summary.duration}s`}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, -176],
