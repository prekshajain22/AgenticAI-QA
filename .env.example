# ==========================================
# AGENTIC AI - QA Automation Framework
# Copy this file to .env and fill in values
# ==========================================

# Environment name (e.g. QA, staging, prod)
ENVIRONMENT=QA

# Base URL of the application under test
BASE_URL=https://www.saucedemo.com

# ==========================================
# Browser settings (Playwright)
# ==========================================
# Browser engine: chromium | firefox | webkit
BROWSER=chromium
# Run browser in headless mode: True | False
HEADLESS=True
# Slow-motion delay in milliseconds (0 = off)
SLOW_MO=0

# ==========================================
# Timeouts (milliseconds)
# ==========================================
DEFAULT_TIMEOUT=5000
DEFAULT_NAVIGATION_TIMEOUT=10000

# ==========================================
# AI model settings — pick ONE free provider
# ==========================================

# Find models here https://openrouter.ai/models?q=free
# OpenRouter 
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Google Gemini
GEMINI_API_KEY=AIza-your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (paid)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-2024-08-06

# ==========================================
# JIRA settings (used by jira_agent.py)
# ==========================================
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-jira-email@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=SAUCE
JIRA_PROJECT_NAME=SauceDemo

# ==========================================
# Flask service
# ==========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=your-flask-secret-key-here
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# ==========================================
# Flask test runner paths and filenames
# ==========================================
TEST_RUNNER_OUTPUT_DIR=output
TEST_RUNNER_REPORTS_DIR=reports
TEST_RUNNER_LOGS_DIR=logs
TEST_RUNNER_SCREENSHOTS_DIR=screenshots
TEST_RUNNER_QA_REPORT_FILENAME=QA_Execution_Report.pdf
TEST_RUNNER_JIRA_PIPELINE_REPORT_FILENAME=Jira_Pipeline_Report.pdf

# ==========================================
# Flask test runner endpoints
# ==========================================
TEST_RUNNER_RUN_TESTS_ENDPOINT=/run-tests
TEST_RUNNER_RUN_JIRA_PIPELINE_ENDPOINT=/run-jira-pipeline
TEST_RUNNER_PIPELINE_STATUS_ENDPOINT=/pipeline-status
TEST_RUNNER_HEALTH_ENDPOINT=/health
TEST_RUNNER_DOWNLOAD_REPORT_ENDPOINT=/download-report
TEST_RUNNER_DOWNLOAD_PIPELINE_PDF_ENDPOINT=/download-pipeline-pdf
