# ==========================================
# AGENTIC AI - QA Automation Framework
# Copy this file to .env and fill in values
# ==========================================

# Environment name (e.g. QA, staging, prod)
ENVIRONMENT=QA

# Base URL of the application under test
BASE_URL=https://www.saucedemo.com

# ==========================================
# Browser settings (Playwright)
# ==========================================
# Browser engine: chromium | firefox | webkit
BROWSER=chromium
# Run browser in headless mode: True | False
HEADLESS=True
# Slow-motion delay in milliseconds (0 = off)
SLOW_MO=0

# ==========================================
# Timeouts (milliseconds)
# ==========================================
DEFAULT_TIMEOUT=5000
DEFAULT_NAVIGATION_TIMEOUT=10000

# ==========================================
# AI model settings — pick ONE free provider
# ==========================================

# ── Option 1: Groq (recommended — free, fast, no credit card)
# Sign up at https://console.groq.com → API Keys
GROQ_API_KEY=your-groq-api-key-here
# Best model for tool/function calling:
GROQ_MODEL=llama-3.3-70b-versatile

# ── Option 2: Google Gemini (free tier via aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Option 3: OpenAI (paid)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# Model identifier, e.g. gpt-4o-2024-08-06
OPENAI_MODEL=gpt-4o-2024-08-06

# MCPConfig.default_client() picks: GROQ_API_KEY first, then GEMINI_API_KEY.


# ==========================================
# JIRA settings (used by jira_agent.py)
# ==========================================
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-jira-email@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=CRED
JIRA_PROJECT_NAME=CreditBank

# ==========================================
# Flask service
# ==========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=your-flask-secret-key-here
